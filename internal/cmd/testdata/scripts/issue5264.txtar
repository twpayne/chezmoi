httpd www

exec chezmoi apply
exec chezmoi re-add $HOME${/}dir/regular
exec chezmoi status

-- home/user/.local/share/chezmoi/.chezmoiexternal.toml.tmpl --
["dir/external_file"]
    type = "file"
    url = "{{ env "HTTPD_URL" }}/README.md"
-- home/user/.local/share/chezmoi/exact_dir/regular --
# contents of dir/regular
-- home/user/dir/regular --
# contents of dir/regular
-- www/README.md --
# contents of README.md
