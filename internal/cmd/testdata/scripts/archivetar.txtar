mksourcedir

exec chezmoi archive --output=archive.tar
exec tar -tf archive.tar
[!openbsd] cmp -text stdout golden/archive-tar
[openbsd] cmp stdout golden/archive-tar-openbsd

exec chezmoi archive --gzip --output=archive.tar.gz
exec tar -tzf archive.tar.gz
[!openbsd] cmp -text stdout golden/archive-tar
[openbsd] cmp stdout golden/archive-tar-openbsd

-- golden/archive-tar --
.create
.dir/
.dir/file
.dir/subdir/
.dir/subdir/file
.empty
.executable
.file
.private
.readonly
.symlink
.template
-- golden/archive-tar-openbsd --
.create
.dir
.dir/file
.dir/subdir
.dir/subdir/file
.empty
.executable
.file
.private
.readonly
.symlink
.template
